@{
    ViewData["Title"] = "Home";
    ViewData["Page"] = "home";
}

<div class="site-shell">
    <header class="topbar">
        <a class="brand" href="/">
            <span class="brand-mark">AC</span>
            <span>Audio Classification</span>
        </a>
        <nav class="nav-links">
            <a href="/login">Login</a>
            <a class="nav-cta" href="/register">Register</a>
        </nav>
    </header>

    <main class="hero-layout">
        <section class="hero-card">
            <p class="eyebrow">Sound recognition platform</p>
            <h1>Simple audio classification UI for your project</h1>
            <p class="hero-copy">
                Sign in
            </p>
            <div class="hero-actions">
                <a class="button button-primary" href="/register">Create account</a>
                <a class="button button-secondary" href="/login">Sign in</a>
            </div>
        </section>
    </main>
</div>
